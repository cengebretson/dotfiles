/.config/tmux/appearance.conf
.config/fish/fish_variables
.config/git/config.local
.config/fish/secrets.fish
.config/claude/.claude.json
.config/codex/config.toml
/.config/claude/hooks/handlers/domain-docs
/.config/codex/hooks/handlers/domain-docs
/.config/codex/skills/ctx-browser-debug/
/.config/codex/skills/ctx-resume/
/.config/codex/skills/ctx-triage/
.ssh/config.local
# Machine-local CA bundle snapshot of this host's trust store, including any
# corporate/MDM roots. Regenerate with .config/certs/refresh-ca-bundle.sh
# rather than syncing it between machines.
.config/certs/*.pem

# Holds plaintext registry tokens (GitHub Packages, fontawesome) and is mode 600.
# Never track it; recover the values from the keychain entries instead
# (github.com/cengebretson/packages).
.npmrc

# TPM clones the plugin repos here; the plugin list in tmux.conf is the source
# of truth and `prefix + I` restores them on a fresh machine.
/.config/tmux/plugins/

# Generated by vim.pack. Plugin versions are pinned per-spec with version/tag in
# lua/plugins/init.lua, so this lockfile is derived state, not the pin.
/.config/nvim-v12/nvim-pack-lock.json

# Superfile installs its stock hotkeys and bundled themes alongside the tracked
# portable config. Keep those generated defaults machine-local.
/.config/superfile/hotkeys.toml
/.config/superfile/theme/

# Editor/tool backups (e.g. ghostty config.bak, claude settings.json.bak).
*.bak

# SSH: only the shared config is tracked. Keys, known_hosts and the agent
# environment stay machine-local, so a broad `dots add .ssh` can never stage
# a private key.
/.ssh/*
!/.ssh/config

# gh stores its OAuth token here.
/.config/gh/hosts.yml

# Installer-managed symlinks into apps, uv tools and plugin checkouts.
/.local/bin/los-scripts
/.local/bin/paseo
/.local/bin/pre-commit
/.local/bin/python3.12
/.local/bin/tmux-attention

# Dated backups (config.toml.bak-20260910) that *.bak does not match.
*.bak-*
