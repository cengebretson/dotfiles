#!/usr/bin/env bash
# shellcheck disable=SC2016  # the backticks are literal Markdown for the agent
# Remind the agent of both tmux header fields on every prompt. Context passes
# via stdout (one line). Shared by Claude and Codex through handler symlinks.
set -u
[ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || exit 100
command -v tmux >/dev/null 2>&1 || exit 100
command -v tmux-attention >/dev/null 2>&1 || exit 100

summary="$(tmux show-options -pqv -t "$TMUX_PANE" @agent_pane_summary 2>/dev/null || printf '')"
project="$(tmux show-options -pqv -t "$TMUX_PANE" @agent_pane_context_project 2>/dev/null || printf '')"
override="$(tmux show-options -pqv -t "$TMUX_PANE" @agent_pane_context_override 2>/dev/null || printf '')"
printf 'tmux header project is "%s" (declared override: "%s"). ' "${project:-unset}" "${override:-none}"
if [ -n "$summary" ]; then
	printf 'Pane summary is "%s". ' "$summary"
else
	printf 'Pane summary is unset. '
fi
printf '%s\n' 'Before task tools, reconcile the project with the current task and set/update the 3-5 word summary. When a ticket key becomes known from trusted Jira, PR, branch or task metadata, use `tmux-attention project set <KEY> --slug <short-slug>` if automatic context does not match; do not infer keys from arbitrary prompt text. Clear a previous ticket override when switching to non-ticket work. Reconcile again when new task metadata arrives and verify both fields before the final reply. Retain the latest task or completion summary between replies; replace it on task changes, and clear it only on session end or explicit reset.'
