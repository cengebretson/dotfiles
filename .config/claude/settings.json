{
  "editorMode": "vim",
  "effortLevel": "high",
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "playwright@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "repo": "mksglu/context-mode",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" notification",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|idle_prompt"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": false,
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" format-on-edit",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/claude/hooks/approve-compound-bash.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" context-mode-cache-heal >/dev/null 2>&1",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" domain-docs",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.config/claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" agent-turn-stop",
            "type": "command"
          },
          {
            "async": true,
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" stop-failure",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" prompt-clear",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "additionalDirectories": [],
    "allow": [
      "mcp__plugin_context-mode_context-mode__*",
      "Bash(mkdir -p *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(docker exec *)",
      "Bash(ssh-add -l)",
      "Bash(echo *)",
      "Bash(ast-grep *)",
      "Bash(yq *)",
      "Bash(go *)",
      "Bash(nvim --headless *)",
      "Bash(open *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(uv *)",
      "Bash(python3 *)",
      "Bash(prettier *)",
      "Bash(stylua *)",
      "Bash(mise *)",
      "Bash(gh api*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr create*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "mcp__github__*",
      "Bash(pr-report*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git ls-remote*)",
      "Bash(git remote*)",
      "Bash(git release*)",
      "Bash(git --git-dir=$HOME/.dotfiles --work-tree=$HOME *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git clean -f*)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(docker compose * down -v*)"
    ]
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "/private/tmp"
      ]
    }
  },
  "statusLine": {
    "command": "~/.config/claude/statusline.sh",
    "hideVimModeIndicator": true,
    "type": "command"
  },
  "theme": "dark-ansi",
  "tui": "fullscreen"
}