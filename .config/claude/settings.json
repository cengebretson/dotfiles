{
  "env": {
    "GIT_EDITOR": "true"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__plugin_context-mode_context-mode__*",
      "Bash(ssh-add -l)",
      "Bash(open *)",
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go version)",
      "Bash(bun test*)",
      "Bash(bun install*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv tool list*)",
      "Bash(uv python list*)",
      "Bash(mise ls*)",
      "Bash(mise current*)",
      "Bash(mise which *)",
      "Bash(mise install*)",
      "Bash(mise doctor*)",
      "Bash(gh api user*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr create*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(los-scripts *)",
      "Bash(/Users/cengebretson/workspace/scripts/bin/los-scripts *)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git ls-remote*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url *)",
      "Bash(git remote show *)",
      "Bash(git release*)",
      "Bash(git --git-dir=\"$HOME/.dotfiles\" --work-tree=\"$HOME\" status*)",
      "Bash(git --git-dir=\"$HOME/.dotfiles\" --work-tree=\"$HOME\" diff*)",
      "Bash(git --git-dir=\"$HOME/.dotfiles\" --work-tree=\"$HOME\" log*)",
      "Bash(git --git-dir=\"$HOME/.dotfiles\" --work-tree=\"$HOME\" show*)",
      "Bash(git --git-dir=\"$HOME/.dotfiles\" --work-tree=\"$HOME\" ls-files*)",
      "WebFetch(domain:claude.ai)"
    ],
    "deny": [
      "Bash(git clean -f*)",
      "Bash(git * clean -f*)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * +*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git * reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(docker compose * down -v*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": []
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" notification"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi-permission",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Read|Glob|Grep|WebFetch|WebSearch|Task|Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" agent-activity",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" format-on-edit"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/approve-compound-bash.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" agent-turn-active",
            "async": true
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "async": true
          },
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" session-end-summary",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" context-mode-cache-heal >/dev/null 2>&1"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" domain-docs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" agent-turn-stop"
          },
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" stop-failure"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" prompt-clear"
          },
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" summary-reminder"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/claude/hooks/dispatch.sh\" moshi",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh",
    "hideVimModeIndicator": true
  },
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "playwright@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "/private/tmp"
      ]
    },
    "excludedCommands": [
      "tmux-attention"
    ]
  },
  "feedbackDrafts": "off",
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "showThinkingSummaries": false,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "verbose": false,
  "autoCompactEnabled": true,
  "showTurnDuration": false,
  "autoMode": {
    "allow": [
      "$defaults"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(git push* origin develop*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
