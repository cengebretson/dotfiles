# Per-machine account/auth state — never share across machines
.claude.json
.claude.json.backup
.credentials.json

# Per-machine settings overrides (absolute paths, local-only grants)
settings.local.json
rules/local.md

# Per-machine runtime/state markers
.last-cleanup
.last-update-result.json
remote-settings.json
tasks/

# Runtime and session data
sessions/
history.jsonl
cache/
hooks/logs/
hooks/*.log
telemetry/
stats-cache.json
paste-cache/
plugins/
projects/
downloads/
shell-snapshots/
backups/
file-history/
memory/
plans/
mcp-needs-auth-cache.json
powerline/
session-env/
claude-powerline.json
policy-limits.json
context-mode/
# Claude writes timestamped backups (settings.json.bak.20260615221755), so the
# glob must extend past .bak or they show up as untracked noise forever.
*.bak*
