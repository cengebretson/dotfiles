# Per-machine account/auth state — never share across machines
.claude.json
.claude.json.backup
.credentials.json

# Per-machine settings overrides (absolute paths, local-only grants)
settings.local.json

# Per-machine runtime/state markers
.last-cleanup
.last-update-result.json
remote-settings.json*
tasks/

# Runtime and session data
sessions/
history.jsonl
cache/
hooks/logs/
hooks/*.log
telemetry/
stats-cache.json
paste-cache/
plugins/
projects/
downloads/
shell-snapshots/
backups/
file-history/
memory/
plans/
mcp-needs-auth-cache.json
powerline/
session-env/
claude-powerline.json
policy-limits.json*
context-mode/
chrome/
# Claude writes timestamped backups (settings.json.bak.20260615221755), so the
# glob must extend past .bak or they show up as untracked noise forever.
*.bak*

# Claude-managed skill copies and runtime state.
skills/.trash/
skills/synced/
state/
feedback/

# Deployed and rewritten by the context-mode plugin on every start; tracking it
# only turned plugin upgrades into dotfile diffs. The handler skips it when absent.
hooks/context-mode-cache-heal.mjs
