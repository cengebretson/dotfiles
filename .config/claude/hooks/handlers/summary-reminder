#!/usr/bin/env bash
# Remind the agent of its tmux pane summary on every prompt, so a change of
# task reliably gets a new 3-5 word phrase. Context passes via stdout (one
# line). Shared by Claude and Codex: the Codex handler symlinks here.
set -u
[ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] || exit 100
command -v tmux >/dev/null 2>&1 || exit 100
command -v tmux-attention >/dev/null 2>&1 || exit 100

# shellcheck disable=SC2016  # the backticks are literal Markdown for the agent
summary="$(tmux show-options -pqv -t "$TMUX_PANE" @agent_pane_summary 2>/dev/null || printf '')"
if [ -n "$summary" ]; then
	printf 'tmux pane summary is "%s". If this message changes the task, update it with `tmux-attention summary set <3-5 words>`; otherwise leave it.\n' "$summary"
else
	printf 'tmux pane summary is unset. Once the task is clear, set it with `tmux-attention summary set <3-5 words>`.\n'
fi
