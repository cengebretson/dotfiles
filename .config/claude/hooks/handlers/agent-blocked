#!/usr/bin/env bash
# tmux attention marker: flag the pane as waiting on an approval decision.
#
# NOT the `blocked` state despite the name: the plugin maps approval_required to
# `input`, reserving `blocked` for genuine failures
# (blocked/stop_failure/hook_failure, the latter two already covered by
# stop-failure). So this lands on the same state the `notification` handler
# sets; what it adds is the source/reason metadata that fzf-jump renders dimmed
# next to the pane.
#
# Notification (matcher permission_prompt|idle_prompt) is what has actually been
# firing for permission prompts; if PermissionRequest fires too, both write the
# same state and the richer one wins. Worth collapsing to one handler if that
# overlap ever matters.
set -u
script="${TMUX_ATTENTION_CLI:-$HOME/.local/bin/tmux-attention}"
[ -x "$script" ] || exit 100
exec "$script" event approval_required --source claude --reason permission_prompt >/dev/null 2>&1
