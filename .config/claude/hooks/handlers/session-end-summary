#!/usr/bin/env bash
# Clear this pane's tmux summary when the agent session ends, so a closed
# session never leaves a stale phrase in the status bar or fzf-jump.
#
# Only the pane's own agent may clear it: short-lived `claude mcp ...` or
# `claude -p` runs started from inside the agent's tools also fire SessionEnd
# and inherit TMUX_PANE, and would otherwise wipe the live agent's phrase. The
# pane's agent is the claude process whose parent is the pane's shell.
set -u
[ -n "${TMUX_PANE:-}" ] || exit 100
script="${TMUX_ATTENTION_CLI:-$HOME/.local/bin/tmux-attention}"
[ -x "$script" ] || exit 100

pane_shell="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_pid}' 2>/dev/null)" || exit 100
[ -n "$pane_shell" ] || exit 100

# Walk up from this hook to the nearest claude ancestor.
pid=$$
agent_parent=""
for _ in 1 2 3 4 5 6 7 8; do
	read -r ppid comm < <(ps -o ppid=,comm= -p "$pid" 2>/dev/null) || break
	[ -n "${ppid:-}" ] || break
	case "${comm##*/}" in
		claude | claude.exe)
			agent_parent="$ppid"
			break
			;;
	esac
	pid="$ppid"
done

[ "$agent_parent" = "$pane_shell" ] || exit 0
exec "$script" summary clear --target "$TMUX_PANE" >/dev/null 2>&1
