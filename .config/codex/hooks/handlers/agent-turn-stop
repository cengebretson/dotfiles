#!/usr/bin/env bash
# Complete this Codex turn by clearing its tmux context and marking the response
# ready. Pairs with prompt-clear (turn-start) on UserPromptSubmit.
set -u
script="${TMUX_ATTENTION_CLI:-$HOME/.local/bin/tmux-attention}"
[ -x "$script" ] || exit 100
exec "$script" turn-done --source codex --reason response_ready >/dev/null 2>&1
