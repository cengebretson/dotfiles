#!/usr/bin/env bash
# Keep the tmux "working" marker alive across automatic continuations.
#
# prompt-clear (UserPromptSubmit) calls turn-start and agent-turn-stop (Stop)
# calls turn-done. When Codex continues on its own after a Stop, no new prompt
# is submitted, so nothing re-marks the pane and it reads as idle while an agent
# is in fact still running. turn-active is idempotent: an already-active pane is
# left untouched, an inactive one transitions as if turn-start had run.
#
# Mirrors the Claude handler of the same name; hooks.json already dispatches
# PreToolUse here.
set -u
script="${TMUX_ATTENTION_CLI:-$HOME/.config/tmux/plugins/tmux-attention/scripts/tmux-attention}"
[ -x "$script" ] || exit 100
exec "$script" turn-active >/dev/null 2>&1
