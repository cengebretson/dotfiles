# Per-machine account/auth state — never share across machines
auth.json
.credentials.json

# Runtime and session data
sessions/
history.jsonl
log/
logs/
tmp/
.tmp/
cache/
context-mode/
thread-writer-locks/
backups/
# Installed plugin artifacts, never dotfiles. Ignored wholesale (as claude/
# does) because Codex keeps adding new staging subdirs — .plugin-appserver,
# .remote-plugin-install-staging — and enumerating them individually meant
# plugins/ kept resurfacing as untracked.
plugins/
shell_snapshots/
version.json
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal

# Machine-local Codex state
config.toml
installation_id
.personality_migration
models_cache.json
hooks.json.bak.*
goals_*
logs_*
memories_*
state_*
.codex-global-state.json*
session_index.jsonl
docker-local.config.toml
yolo.config.toml
local.md

# Per-machine caches and import history
claude-cowork-import-history.json
claude-cowork-transcript-imports/
cloud-config-bundle-cache.json
cloud-requirements-cache.json
vendor_imports/

# Installed macOS computer-use app bundle (binary, not config)
computer-use/

# Per-machine state markers and generated runtime artifacts that previously
# leaked through as untracked candidates
.sandbox_migration
generated_images/
mcp-oauth-locks/

# Machine-local agent memory: project-scoped, churny, and not generic, so it is
# deliberately unversioned and out of dotfiles. (It was briefly its own nested
# git repo; that was removed 2026-09-01.)
memories/

# Live execpolicy rules auto-grow per machine/repo (auto_review learns them) —
# keep machine-local. The shareable baseline is rules/curated.rules, which IS
# tracked: seed a new machine's default.rules from it, and fold genuinely
# reusable rules back into it instead of tracking the live file. Keep one-shot
# approvals (hardcoded PR/run ids, /tmp paths) out of curated.rules.
rules/default.rules
# Local rules backups / reference snapshots
rules/*.backup-*
rules/*.dotfiles-reference-*

# Installed/vendored skills are managed by Codex, not personal dotfiles
skills/.system/
# No trailing slash: playwright is a symlink into ~/workspace/scripts/skills,
# and git sees a symlink as a file, so a dir-only pattern never matches it.
skills/playwright
# Note: AGENTS.md and config.shared.toml are intentionally trackable.
# Keep secrets out of shared config — use env vars, never hardcoded keys.
