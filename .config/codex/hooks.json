{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" agent-turn-active",
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "matcher": "local_shell|shell|shell_command|exec_command|Bash|Shell|apply_patch|Edit|Write|grep_files|ctx_execute|ctx_execute_file|ctx_batch_execute|ctx_fetch_and_index|ctx_search|ctx_index|mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook codex pretooluse"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" permission-request-notify",
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" local-instructions",
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" moshi",
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" domain-docs",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook codex sessionstart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" agent-turn-stop",
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook codex stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" prompt-clear",
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/codex/hooks/dispatch.sh\" moshi",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook codex userpromptsubmit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook codex posttooluse"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook codex precompact"
          }
        ]
      }
    ]
  }
}
